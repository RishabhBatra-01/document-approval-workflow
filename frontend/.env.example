# Frontend environment — copy to frontend/.env.local and fill in.
#
# WARNING: every VITE_ variable is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. Only put public values here.
# The secret/service_role key and the database password must NEVER appear in
# this file. Phase 4 greps the production build to confirm they do not.

# Same project URL as the backend uses. Public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLISHABLE key (newer dashboards: sb_publishable_...; older: the anon
# JWT). Designed to be public — it grants nothing on its own once the Data API
# is disabled and the storage bucket is private.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the Django API lives. The Render HTTPS URL replaces this at deployment.
VITE_API_BASE_URL=http://127.0.0.1:8000
