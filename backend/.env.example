# Backend environment — copy to backend/.env and fill in. NEVER commit backend/.env.
# Every value here is backend-only. None of it may ever appear in the frontend build.

# --- Django ---
# Generate locally, do not reuse anywhere else:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Comma-separated. Local dev shown; the Render hostname gets added at the deploy gate.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Exact frontend origins. Never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Supabase project ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET key (newer dashboards: sb_secret_...; older: the service_role JWT).
# This bypasses all row-level security. Backend only. Never sent to the browser.
SUPABASE_SECRET_KEY=

# --- Supabase Storage ---
# Create this bucket yourself and set it to PRIVATE (public toggle off).
SUPABASE_STORAGE_BUCKET=submissions
# Seconds a signed read URL stays valid. Short on purpose — it is a bearer link.
SUPABASE_SIGNED_URL_TTL=300

# --- Database (Django ORM) ---
# Dashboard → Project Settings → Database → Connection string → "Session pooler".
# Use the SESSION pooler, not the transaction pooler on 6543: the transaction
# pooler does not support prepared statements and will break Django migrations.
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=
DB_SSLMODE=require

# --- Account provisioning ---
# Emails for the three evaluation accounts. Passwords are NOT stored here — the
# provisioning command prompts for them interactively. With
# --password-from-env it reads PROVISION_PASSWORD_SUBMITTER_A,
# PROVISION_PASSWORD_SUBMITTER_B and PROVISION_PASSWORD_REVIEWER instead.
# Each account has its own password: sharing one between the two submitters
# would make "submitter A cannot read submitter B" rest on a shared secret.
PROVISION_SUBMITTER_A_EMAIL=submitter-a@example.com
PROVISION_SUBMITTER_B_EMAIL=submitter-b@example.com
PROVISION_REVIEWER_EMAIL=reviewer@example.com

# Public key, also needed by the backend test suite to sign in like a browser.
SUPABASE_PUBLISHABLE_KEY=
# Safety guard: integration tests refuse to run unless this matches SUPABASE_URL.
SUPABASE_TEST_PROJECT_REF=
# Optional: if set and equal to the configured project, tests refuse outright.
SUPABASE_DEPLOYMENT_PROJECT_REF=
